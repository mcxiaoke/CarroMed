<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PermissionCheckScreen（系统特权自检与保活指引） -->
    <string name="perm_title">系统特权自检与保活指引</string>
    <string name="perm_back_cd">返回</string>

    <!-- 1. 精确闹钟 -->
    <string name="perm_exact_alarm_title">1. 精确闹钟 (Exact Alarm)</string>
    <string name="perm_exact_alarm_desc">决定提醒是「到点必响」还是「系统择机送达」。用药提醒属于《Android 闹钟类应用》标准场景，CarroMed 已声明 USE_EXACT_ALARM，正常安装即自动授予；若这里显示未授权，说明系统把它降级处理了。</string>
    <string name="perm_action_grant">去授权</string>

    <!-- 2. 发送通知 -->
    <string name="perm_notification_title">2. 发送通知 (Notification)</string>
    <string name="perm_status_granted">已授权</string>
    <string name="perm_status_denied">未授权</string>
    <string name="perm_notification_desc">Android 13+ 必须显式允许通知，否则闹钟会照常唤醒但屏幕上什么都不会出现。</string>
    <string name="perm_action_enable">去开启</string>

    <!-- 3. 忽略电池优化 -->
    <string name="perm_battery_title">3. 忽略电池优化 (Doze 白名单)</string>
    <string name="perm_status_whitelisted">已加入白名单</string>
    <string name="perm_status_not_whitelisted">未加入</string>
    <string name="perm_battery_desc">强烈推荐。防止手机在夜间待机灭屏时冻结后台 AlarmManager。</string>
    <string name="perm_action_settings">去设置</string>

    <!-- 4. 锁屏显示与后台自启动 -->
    <string name="perm_vendor_title">4. 锁屏显示与后台自启动</string>
    <string name="perm_status_manual">需手动确认</string>
    <string name="perm_vendor_desc">国内主流厂商（小米/华为/OPPO/vivo/荣耀）需手动在手机管家中开启【自启动】与【锁屏显示】。该项无法通过系统 API 程序化检测，请自行到手机管家确认。</string>
</resources>
