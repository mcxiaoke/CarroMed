<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PermissionCheckScreen（防漏提醒指南） -->
    <string name="perm_title">防漏提醒指南</string>
    <string name="perm_back_cd">返回</string>

    <!-- 1. 精确闹钟 -->
    <string name="perm_exact_alarm_title">1. 精确闹钟 (Exact Alarm)</string>
    <string name="perm_exact_alarm_desc">确保服药提醒在设定时间准时响铃。若未开启，系统可能会推迟或合并提醒通知。</string>
    <string name="perm_action_grant">去授权</string>

    <!-- 2. 发送通知 -->
    <string name="perm_notification_title">2. 发送通知 (Notification)</string>
    <string name="perm_status_granted">已授权</string>
    <string name="perm_status_denied">未授权</string>
    <string name="perm_notification_desc">Android 13+ 必须显式允许通知，否则闹钟会照常唤醒但屏幕上什么都不会出现。</string>
    <string name="perm_action_enable">去开启</string>

    <!-- 3. 锁屏全屏提醒 -->
    <string name="perm_fullscreen_title">3. 锁屏全屏提醒 (Full-Screen)</string>
    <string name="perm_fullscreen_desc">Android 14+ 需单独授权；未授权时锁屏只会收到普通通知横幅，不会全屏亮屏弹出「确认已服」界面。</string>
    <string name="perm_status_not_required">系统无需授权</string>

    <!-- 4. 忽略电池优化 -->
    <string name="perm_battery_title">4. 忽略电池优化 (Doze 白名单)</string>
    <string name="perm_status_whitelisted">已加入白名单</string>
    <string name="perm_status_not_whitelisted">未加入</string>
    <string name="perm_battery_desc">建议开启。防止手机在灭屏休眠时拦截提醒，确保后台准时响铃。</string>
    <string name="perm_action_settings">去设置</string>

    <!-- 5. 锁屏显示与后台自启动 -->
    <string name="perm_vendor_title">5. 锁屏显示与后台自启动</string>
    <string name="perm_status_manual">需手动确认</string>
    <string name="perm_vendor_desc">主流手机厂商（小米、华为、OPPO、vivo 等）建议在系统设置中允许【后台自启动】与【锁屏通知】，防止熄屏时漏提醒。</string>
    <string name="perm_action_vendor_settings">前往设置</string>
    <string name="perm_open_settings_failed">无法打开系统设置，请手动前往系统设置查找本应用</string>

    <!--
      通知权限被「永久拒绝」后的低频引导横幅（3-3）。
      用户勾了「不再询问」后系统不再弹框，`notify()` 静默失败 ⇒ 续期跳过 ⇒
      全屏提醒也失效，整条提醒链路静默死亡。必须在界面上说清楚并给出自救入口。
    -->
    <string name="perm_banner_title">服药提醒当前不会弹出</string>
    <string name="perm_banner_body">通知权限已被拒绝，提醒无法显示在屏幕上。请到系统设置中重新开启本应用的通知权限。</string>
    <string name="perm_banner_dismiss">暂不处理</string>
</resources>
