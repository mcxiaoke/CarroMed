<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 服药提醒通知 (Android 13+ 运行时申请) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      精确闹钟。用药提醒是《Android 闹钟类应用》标准场景：
      1. Android 13+ (API 33+)：声明 USE_EXACT_ALARM，由系统直接授予。
      2. Android 12 & 12L (API 31-32)：系统尚未引入 USE_EXACT_ALARM，必须声明 SCHEDULE_EXACT_ALARM，
         加 maxSdkVersion="32" 避免在 Android 14+ 上触发默认拒绝。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 锁屏全屏强提醒 (Android 14+ 需通过 canUseFullScreenIntent 鉴权) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 开机自启恢复闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 隐私基线: 严禁申请 INTERNET，物理断网 -->

    <application
        android:name=".CarroMedApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CarroMed">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CarroMed"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          锁屏强提醒全屏交互界面 (Full-Screen Intent)。

          ⚠️ launchMode 是 singleTop，且**必须**配 `AlarmAlertActivity.onNewIntent`。
          为什么不能只靠 launchMode 解决（3-1 实测结论）：
          `createIntent` 带 `FLAG_ACTIVITY_NEW_TASK` + `taskAffinity=""`，
          系统会**复用**已有任务与该实例并回调 `onNewIntent` —— 实测把 launchMode 改成
          `standard` 后连续两次拉起**仍只有 1 个 ActivityRecord**、界面仍显示第一条的药名
          （改 `0x18000000`（NEW_TASK|MULTIPLE_TASK）才会新建实例，但那会让同批多药堆出多个任务）。
          所以正确修法是保留 singleTop、在 `onNewIntent` 里整体替换展示内容（不 recreate，避免闪屏）。
        -->
        <activity
            android:name=".ui.screen.alert.AlarmAlertActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:theme="@style/Theme.CarroMed" />

        <!-- 精确闹钟触发 → 弹服药通知 -->
        <receiver
            android:name=".core.alarm.AlarmReceiver"
            android:exported="false" />

        <!-- 通知栏快捷操作 (已吃/推迟/跳过) -->
        <receiver
            android:name=".core.alarm.DoseActionReceiver"
            android:exported="false" />

        <!-- 开机/换包/改时自愈对账 -->
        <receiver
            android:name=".core.alarm.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- ⚠️ 必须是 TIME_SET：Intent.ACTION_TIME_CHANGED 这个常量的"值"是
                     "android.intent.action.TIME_SET"，系统从不广播 "…TIME_CHANGED" 字面量。
                     写成 TIME_CHANGED 会让本 filter 永不匹配，「改时自愈」整条能力静默失效。 -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 导出文件分享 (CSV / JSON 备份) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
